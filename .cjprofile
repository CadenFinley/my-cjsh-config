if [ "${SHLVL:-0}" -eq 1 ] && [ -z "${TMUX:-}" ]; then
	cjshopt login-startup-arg --minimal
	cjshopt login-startup-arg --secure
	cjshopt status-hints off

	tmux() {
		if [ "$#" -gt 0 ]; then
			command tmux "$@"
			return
		fi

		if command tmux has-session -t main 2>/dev/null; then
			command tmux attach-session -t main
			return
		fi

		command tmux new-session -d -s main
		command tmux split-window -h -t main:1 \; send-keys btop Enter
		command tmux select-window -t main:1
		command tmux select-pane -L -t main:1
		command tmux split-window -v -t main:1
		command tmux select-pane -U -t main:1
		command tmux send-keys -t main:1 'tput cols; tput lines' Enter
		command tmux attach-session -t main
}
else 
	source ~/.profile
fi
