cjcloc() {
    set -eu
    list=$(mktemp)
    rows=$(mktemp)
    trap 'rm -f "$list" "$rows"' EXIT

    if [ "$#" -eq 0 ]; then
        set -- .
    fi

    for dir in "$@"; do
        if [ ! -d "$dir" ]; then
            printf 'cjcloc: %s is not a directory\n' "$dir" >&2
            return 1
        fi
    done

    : >"$list"
    for dir in "$@"; do
        find "$dir" \
            \( -name .git -o -name node_modules -o -name build -o -name dist -o -name target -o -name .cache -o -name .next -o -name .venv -o -name venv \) -type d -prune \
            -o -type f -print >>"$list"
    done
    total_files=$(wc -l <"$list")
    if [ "$total_files" -eq 0 ]; then
        printf 'No files found.\n'
        return 0
    fi

    scanned=0
    counted=0
    total=0
    PROGRESS_STEP=1
    while IFS= read -r file <&3; do
        scanned=$((scanned + 1))
        if [ -f "$file" ]; then
            if [ ! -s "$file" ] || LC_ALL=C grep -Iq . "$file" 2>/dev/null; then
                if loc=$(wc -l <"$file" 2>/dev/null); then
                    printf '%s\t%s\n' "$loc" "$file" >>"$rows"
                    total=$((total + loc))
                    counted=$((counted + 1))
                fi
            fi
        fi
        if [ $((scanned % PROGRESS_STEP)) -eq 0 ] || [ "$scanned" -eq "$total_files" ]; then
            percent=$((scanned * 100 / total_files))
            printf '\rProcessed %d/%d files (%d%%)' \
                "$scanned" "$total_files" "$percent" >&2
        fi
    done 3<"$list"
    printf '\n' >&2
    if [ "$counted" -eq 0 ]; then
        printf 'No text files found.\n'
        return 0
    fi
    sort -nr "$rows"
    printf '\n%8s %s\n' '--------' '-----'
    printf '%8d %s (%d files)\n' "$total" 'TOTAL' "$counted"
}

cjcomplexity() {
    set -eu

    tmpdir=${TMPDIR:-/tmp}
    list="$tmpdir/cjccomplexity.$$.list"
    suffix=0
    while [ -e "$list" ]; do
        suffix=$((suffix + 1))
        list="$tmpdir/cjccomplexity.$$.$suffix.list"
    done
    if ! : >"$list"; then
        printf 'cjccomplexity: failed to create temp file: %s\n' "$list" >&2
        return 1
    fi
    trap 'rm -f "$list"' EXIT

    threshold=${CJCCPX_THRESHOLD:-15}
    top=${CJCCPX_TOP:-0}

    case "$threshold" in
        ''|*[!0-9]*)
            printf 'cjccomplexity: CJCCPX_THRESHOLD must be an integer\n' >&2
            return 1
            ;;
    esac

    case "$top" in
        ''|*[!0-9]*)
            printf 'cjccomplexity: CJCCPX_TOP must be an integer\n' >&2
            return 1
            ;;
    esac

    if [ "$#" -eq 0 ]; then
        set -- .
    fi

    for dir in "$@"; do
        if [ ! -d "$dir" ]; then
            printf 'cjccomplexity: %s is not a directory\n' "$dir" >&2
            return 1
        fi
    done

    if ! command -v python3 >/dev/null 2>&1; then
        printf 'cjccomplexity: python3 is required\n' >&2
        return 1
    fi

    for dir in "$@"; do
        find "$dir" \
            \( -name .git -o -name node_modules -o -name build -o -name dist -o -name target -o -name .cache -o -name .next -o -name .venv -o -name venv \) -type d -prune \
            -o -type f \( \
                -name '*.c' -o -name '*.h' -o -name '*.cc' -o -name '*.cpp' -o -name '*.cxx' -o -name '*.hh' -o -name '*.hpp' \
                -o -name '*.py' -o -name '*.js' -o -name '*.jsx' -o -name '*.ts' -o -name '*.tsx' \
                -o -name '*.java' -o -name '*.go' -o -name '*.rs' -o -name '*.swift' \
            \) -print >>"$list"
    done

    if [ ! -s "$list" ]; then
        printf 'No source files found.\n'
        return 0
    fi

    sort -u "$list" -o "$list"

    python3 - "$list" "$threshold" "$top" <<'PY'
from pathlib import Path
import importlib.util
import sys

list_file = Path(sys.argv[1])
threshold = int(sys.argv[2])
top_n = int(sys.argv[3])

if importlib.util.find_spec("lizard") is None:
    print("cjccomplexity: python module 'lizard' is required.", file=sys.stderr)
    print("Install it with: python3 -m pip install --user lizard", file=sys.stderr)
    raise SystemExit(1)

import lizard

files = [line.rstrip("\n") for line in list_file.open(encoding="utf-8", errors="ignore") if line.strip()]
if not files:
    print("No source files found.")
    raise SystemExit(0)

rows = []
total_nloc = 0
total_funcs = 0
total_ccn = 0
total_high = 0

for idx, path in enumerate(files, 1):
    try:
        info = lizard.analyze_file(path)
    except Exception:
        continue

    funcs = list(info.function_list)
    if not funcs:
        continue

    fn_count = len(funcs)
    ccn_sum = sum(fn.cyclomatic_complexity for fn in funcs)
    max_ccn = max(fn.cyclomatic_complexity for fn in funcs)
    avg_ccn = ccn_sum / fn_count
    high = sum(1 for fn in funcs if fn.cyclomatic_complexity > threshold)

    rows.append((avg_ccn, max_ccn, fn_count, ccn_sum, info.nloc, high, path))
    total_nloc += info.nloc
    total_funcs += fn_count
    total_ccn += ccn_sum
    total_high += high

    if idx % 100 == 0 or idx == len(files):
        pct = int(idx * 100 / len(files))
        print(f"\rAnalyzed {idx}/{len(files)} files ({pct}%)", end="", file=sys.stderr)

print(file=sys.stderr)

if not rows:
    print("No analyzable functions found.")
    raise SystemExit(0)

rows.sort(key=lambda r: (r[0], r[1], r[3], r[5], r[2]), reverse=True)

if top_n <= 0 or top_n >= len(rows):
    shown_rows = rows
else:
    shown_rows = rows[:top_n]

high_label = f"HI(>{threshold})"
print(f"{'AVG':>7} {'MAX':>5} {'FUNCS':>6} {'TOT_CCN':>8} {'NLOC':>7} {high_label:>8}  FILE")
for avg_ccn, max_ccn, fn_count, file_ccn, nloc, high, path in shown_rows:
    print(f"{avg_ccn:7.2f} {max_ccn:5d} {fn_count:6d} {file_ccn:8d} {nloc:7d} {high:8d}  {path}")

overall_avg = (total_ccn / total_funcs) if total_funcs else 0.0
print()
print(f"{'FILES':>7} {'FUNCS':>8} {'NLOC':>8} {'TOT_CCN':>9} {'AVG_CCN':>9} {high_label:>8}")
print(f"{len(rows):7d} {total_funcs:8d} {total_nloc:8d} {total_ccn:9d} {overall_avg:9.2f} {total_high:8d}")
if len(shown_rows) == len(rows):
    print("(showing all files by avg complexity)")
else:
    print(f"(showing top {len(shown_rows)} files by avg complexity)")
PY
}

command_not_found_handler() {
    if [ "$DO_HANDLER_THING" = 1 ]; then
        (afplay "/Users/cadenfinley/.local/share/fahhh/fahhh.mp3" >/dev/null 2>&1) &
    fi
    return 127
}

function shlvl_status_line_callback() {
    # default to hidden
    CJSH_STATUS_OUTPUT=""

    local level="$SHLVL"
    case "$level" in
        ''|*[!0-9]*) level=1 ;;
    esac

    # SHLVL=1 -> hide
    if [ "$level" -eq 1 ]; then
        return 0
    fi

    # SHLVL=2 inside tmux -> hide
    if [ "$level" -eq 2 ] && [ -n "$TMUX" ]; then
        return 0
    fi

    # The early returns above leave SHLVL>=3 or SHLVL=2 outside tmux.
    if [ "$level" -ge 2 ]; then
        CJSH_STATUS_OUTPUT="[b][color=ansi-red]SHLVL: $level[/color][/b]"
    fi
}

cjshopt status-line-callback shlvl_status_line_callback
