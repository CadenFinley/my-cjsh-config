    command_here
fi"'
cjshopt keybind ext set 'palette:snippet-case' --title 'Case Statement Snippet' 'cjsh-widget insert "case \$value in
    pattern)
        command_here
        ;;
    *)
        command_here
        ;;
esac"'
cjshopt keybind ext set 'palette:snippet-while' --title 'While Statement Snippet' 'cjsh-widget insert "while [ condition ]; do
    command_here
done"'

