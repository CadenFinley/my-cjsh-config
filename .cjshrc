set -o globstar

CJSH_CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/cjsh"

PS1_FINAL='\D{%a %b %-d %H:%M} [ic-diminish]>[/] '
CJSH_NESTED_LEVEL=""
case "${SHLVL:-}" in
	''|*[!0-9]*) ;;
	*)
		if [ "$SHLVL" -ge 3 ]; then
			CJSH_NESTED_LEVEL=$SHLVL
		elif [ "$SHLVL" -eq 2 ] && [ -z "${TMUX:-}" ]; then
			CJSH_NESTED_LEVEL=$SHLVL
		fi
		;;
esac
if [ -n "$CJSH_NESTED_LEVEL" ]; then
	PS1_FINAL="[ic-diminish]SHLVL=$CJSH_NESTED_LEVEL[/] $PS1_FINAL"
fi

cjsh_prompt_status_precmd() {
	local last_status=$?

	if [ "$last_status" -eq 0 ]; then
		PS1="cjsh> "
	elif [ "$last_status" -eq 127 ] || [ "$last_status" -eq 137 ] || [ "$last_status" -eq 134 ]; then
		PS1="[color=ansi-red]$last_status[/color] cjsh> "
	else
		PS1="[color=ansi-yellow]$last_status[/color] cjsh> "
	fi

	return "$last_status"
}

# RPS1="\@"
# PS1="cjsh> "
# hook add precmd cjsh_prompt_status_precmd

# cjshopt
cjshopt multiline-max-lines 25
cjshopt current-line-number-highlight on
cjshopt line-numbers-replace-prompt on
cjshopt line-numbers-continuation on
cjshopt set-history-max 100000
cjshopt set-completion-max 100000
cjshopt completion-menu-expanded on
cjshopt history-search-case off
cjshopt mouse-clicking smart
cjshopt mouse-clicking-status-line off
cjshopt menu-highlighting reverse
cjshopt right-prompt-follow-cursor on
if command -v claude >/dev/null 2>&1; then
	cjshopt agent-mode set \
		--trigger-prefix 'ai: ' \
		--command 'claude --effort low --print'
fi
if command -c claude-code >/dev/null 2>&1; then
	cjshopt agent-mode set \
		--trigger-prefix 'ai: ' \
		--command 'claude-code --effort low --print'
fi
# keybinds
cjshopt keybind ext set 'alt-b' --title 'Up One Directory' 'cjsh-widget set-buffer "cd .."; cjsh-widget accept'
cjshopt keybind ext set 'alt-l' --title 'Previous Directory' 'cjsh-widget set-buffer "cd -"; cjsh-widget accept'
cjshopt keybind ext set 'alt-!' --title 'Run Previous Command' 'cjsh-widget set-buffer "!!"; cjsh-widget accept'
cjshopt keybind ext set 'alt-e' --title 'Edit Current Line (fc)' 'cjsh-widget set-buffer "fc -c \"$CJSH_LINE\""; cjsh-widget accept'
cjshopt keybind ext set 'ctrl-z' --title 'run fg' 'cjsh-widget set-buffer "fg"; cjsh-widget accept'
cjshopt keybind set toggle-mouse-reporting alt-m

# command palette snippets
cjshopt keybind ext set 'palette:snippet-for' --title 'For Loop Snippet' 'cjsh-widget insert "for item in items; do
    command_here
done"'
cjshopt keybind ext set 'palette:snippet-if' --title 'If Statement Snippet' 'cjsh-widget insert "if [ condition ]; then
    command_here
fi"'
cjshopt keybind ext set 'palette:snippet-case' --title 'Case Statement Snippet' 'cjsh-widget insert "case \$value in
    pattern)
        command_here
        ;;
    *)
        command_here
        ;;
esac"'
cjshopt keybind ext set 'palette:snippet-while' --title 'While Statement Snippet' 'cjsh-widget insert "while [ condition ]; do
    command_here
done"'

# general abbreviations
abbr cjv="cjsh --version"

# cjsh development abbreviations
abbr trst="./tests/run_shell_tests.sh"
abbr bcjv="./build/release/cjsh --version"
abbr cjr="./build/release/cjsh"
abbr cjib="cmake --preset release"
abbr cjb='cmake --build --preset release --parallel'
abbr cjc="cmake --build build --target clean"
abbr cjin="sudo cmake --install build"
abbr cjrelease="  gh workflow run release.yml \
    --ref v1.4.6 \
    -f tag=v1.4.6 \
    -f publish=true"

# aliases
if command ls --color=auto -d . >/dev/null 2>&1; then
	alias ll="ls -lhaSF --color=auto"
	alias ls="ls -F --color=auto"
elif command ls -G -d . >/dev/null 2>&1; then
	alias ll="ls -lhaSFG"
	alias ls="ls -FG"
else
	alias ll="ls -lhaSF"
	alias ls="ls -F"
fi
alias vim="nvim"
alias vi="nvim"

# zoxide
if [ -r "$CJSH_CONFIG_DIR/zoxide_cjsh_init.sh" ]; then
	. "$CJSH_CONFIG_DIR/zoxide_cjsh_init.sh"
fi

cjcloc() {
	"$CJSH_CONFIG_DIR/bin/cjcloc" "$@"
}

cjcomplexity() {
	"$CJSH_CONFIG_DIR/bin/cjcomplexity" "$@"
}

command_not_found_handler() {
	if [ "${DO_HANDLER_THING:-0}" -eq 1 ]; then
		(afplay "$HOME/.local/share/fahhh/fahhh.mp3" >/dev/null 2>&1) &
	fi
	return 127
}

shlvl_status_line_callback() {
	CJSH_STATUS_OUTPUT=""
	if [ -n "$CJSH_NESTED_LEVEL" ]; then
		CJSH_STATUS_OUTPUT="[b][color=ansi-red]SHLVL: $CJSH_NESTED_LEVEL[/color][/b]"
	fi
}

cjshopt status-line-callback shlvl_status_line_callback
