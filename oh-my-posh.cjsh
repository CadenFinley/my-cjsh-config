# oh-my-posh.cjsh
#
# Native Oh My Posh adapter for CJ's Shell. Source this file from ~/.cjshrc
# after setting POSH_CONFIG when a non-default theme is desired.

_omp_command=${OMP_EXECUTABLE:-oh-my-posh}
_omp_executable=$(command -v "$_omp_command" 2>/dev/null)

if [ -z "$_omp_executable" ]; then
    printf 'cjsh: Oh My Posh executable not found: %s\n' "$_omp_command" >&2
else
    export POSH_SESSION_ID=${POSH_SESSION_ID:-cjsh-$$}
    export POSH_CONFIG=${POSH_CONFIG:-}
    export POSH_SHELL=cjsh
    export POSH_SHELL_VERSION=$CJSH_VERSION
    export POWERLINE_COMMAND=oh-my-posh
    export CONDA_PROMPT_MODIFIER=false
    export VIRTUAL_ENV_DISABLE_PROMPT=1
    export PYENV_VIRTUALENV_DISABLE_PROMPT=1

    _omp_start_time=''
    _omp_execution_time=-1
    _omp_no_status=true
    _omp_status=0
    _omp_pipestatus=0
    _omp_job_count=0
    _omp_stack_count=0
    _omp_config_features_cached=false
    _omp_config_features_for=''
    _omp_has_transient_prompt=false

    # Override this function after sourcing the adapter to export extra context
    # immediately before Oh My Posh renders a prompt.
    set_poshcontext() {
        return
    }

    # Switch themes in the current shell. Change POSH_CONFIG in ~/.cjshrc to
    # make the selection persistent.
    posh_theme() {
        if [ "$#" -eq 0 ]; then
            printf '%s\n' "${POSH_CONFIG:-default}"
            return 0
        fi
        if [ "$#" -ne 1 ]; then
            printf 'usage: posh_theme [default|THEME|CONFIG_PATH|URL]\n' >&2
            return 2
        fi

        if [ "$1" = default ]; then
            POSH_CONFIG=''
            export POSH_CONFIG
            return 0
        fi

        if [ -n "${POSH_THEMES_PATH:-}" ] && [ -r "$POSH_THEMES_PATH/$1.omp.json" ]; then
            POSH_CONFIG="$POSH_THEMES_PATH/$1.omp.json"
        elif [ -n "${POSH_THEMES_PATH:-}" ] && [ -r "$POSH_THEMES_PATH/$1.omp.yaml" ]; then
            POSH_CONFIG="$POSH_THEMES_PATH/$1.omp.yaml"
        elif [ -n "${POSH_THEMES_PATH:-}" ] && [ -r "$POSH_THEMES_PATH/$1.omp.toml" ]; then
            POSH_CONFIG="$POSH_THEMES_PATH/$1.omp.toml"
        else
            POSH_CONFIG=$1
        fi
        export POSH_CONFIG
        _omp_config_features_cached=false
    }

    _omp_refresh_config_features() {
        if [ "$_omp_config_features_cached" = true ]; then
            if [ "$_omp_config_features_for" = "$POSH_CONFIG" ]; then
                return
            fi
        fi

        _omp_config_features_for=$POSH_CONFIG
        _omp_config_features_cached=true
        _omp_has_transient_prompt=false

        # `print transient` returns Oh My Posh's built-in "<shell>> " prompt
        # even when the active config has no transient_prompt. Inspect the
        # resolved config so that fallback is not mistaken for theme output.
        if _omp_exported_config=$("$_omp_executable" config export \
            --config="$POSH_CONFIG" --format=json 2>/dev/null); then
            case $_omp_exported_config in
                *'"transient_prompt"'*) _omp_has_transient_prompt=true ;;
            esac
        fi
        _omp_exported_config=''
    }

    _omp_preexec() {
        _omp_start_time=$("$_omp_executable" get millis)
    }

    _omp_render_prompt() {
        "$_omp_executable" print "$1" \
            --config="$POSH_CONFIG" \
            --save-cache \
            --shell=cjsh \
            --shell-version="$CJSH_VERSION" \
            --status="$_omp_status" \
            --pipestatus="$_omp_pipestatus" \
            --no-status="$_omp_no_status" \
            --execution-time="$_omp_execution_time" \
            --job-count="$_omp_job_count" \
            --stack-count="$_omp_stack_count" \
            --terminal-width="${COLUMNS:-0}"
    }

    _omp_precmd() {
        # Capture both values in one assignment so the assignment itself cannot
        # overwrite PIPESTATUS before it is saved.
        _omp_command_state="$?:$PIPESTATUS"
        _omp_status="${_omp_command_state%%:*}"
        _omp_pipestatus="${_omp_command_state#*:}"
        _omp_last_pipe_status="${_omp_pipestatus##* }"
        if [ "$_omp_last_pipe_status" != "$_omp_status" ]; then
            _omp_pipestatus=$_omp_status
        fi

        _omp_execution_time=-1
        _omp_no_status=true
        if [ -n "$_omp_start_time" ]; then
            _omp_now=$("$_omp_executable" get millis)
            _omp_execution_time=$((_omp_now - _omp_start_time))
            _omp_no_status=false
        fi
        _omp_start_time=''

        _omp_job_count=$(jobs -p 2>/dev/null | wc -l | tr -d ' ')
        _omp_stack_count=$(dirs -p 2>/dev/null | wc -l | tr -d ' ')
        if [ "$_omp_stack_count" -gt 0 ]; then
            _omp_stack_count=$((_omp_stack_count - 1))
        fi

        set_poshcontext

        PS1="$(_omp_render_prompt primary)"
        RPS1="$(_omp_render_prompt right)"

        _omp_refresh_config_features
        if [ "$_omp_has_transient_prompt" = true ]; then
            _omp_transient_prompt="$(_omp_render_prompt transient)"
            if [ -n "$_omp_transient_prompt" ]; then
                PS1_FINAL=$_omp_transient_prompt
            else
                PS1_FINAL=$PS1
            fi
        else
            PS1_FINAL=$PS1
        fi

        _omp_transient_rprompt="$(_omp_render_prompt transient-right)"
        if [ -n "$_omp_transient_rprompt" ]; then
            RPS1_FINAL=$_omp_transient_rprompt
        else
            unset RPS1_FINAL
        fi

        return "$_omp_status"
    }

    PS2="$("$_omp_executable" print secondary \
        --config="$POSH_CONFIG" \
        --shell=cjsh \
        --shell-version="$CJSH_VERSION")"

    # Keep re-sourcing this adapter idempotent.
    hook remove preexec _omp_preexec >/dev/null 2>&1
    hook remove precmd _omp_precmd >/dev/null 2>&1
    hook add preexec _omp_preexec
    hook add precmd _omp_precmd
fi
